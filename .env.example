# The DAQ box: NI gRPC device server and SystemLink server are the same host.
DAQ_HOST=192.168.1.129
GRPC_PORT=31763

# SystemLink File service. No defaults in code, so these must be set.
SYSTEMLINK_USER=
SYSTEMLINK_PASSWORD=
SYSTEMLINK_VERIFY_TLS=false

# Optional overrides
# SYSTEMLINK_URI=https://192.168.1.129
# SYSTEMLINK_WORKSPACE=
# SYSTEMLINK_TIMEOUT_S=60
# HOST=192.168.1.72
