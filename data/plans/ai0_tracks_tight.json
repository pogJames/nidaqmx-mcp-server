{
  "cleanup": [
    {
      "action": "stop",
      "args": {
        "target": "outputs"
      },
      "id": "off"
    }
  ],
  "loop": {
    "axes": [
      {
        "from": 0.5,
        "name": "vsupply",
        "step": 0.25,
        "to": 5,
        "unit": "V"
      }
    ],
    "settle_ms": 50
  },
  "on_step_fail": "continue",
  "plan_id": "ai0_tracks_tight",
  "steps": [
    {
      "action": "set_voltage",
      "args": {
        "channel": "ao0",
        "dev": "DAQ1Mod4",
        "volts": "$vsupply"
      },
      "id": "drive"
    },
    {
      "action": "measure_voltage",
      "args": {
        "channels": [
          "ai0"
        ],
        "dev": "DAQ1Mod3",
        "rate": 100,
        "samples": 20
      },
      "id": "read",
      "limits": [
        {
          "of": "$vsupply",
          "op": "within_pct",
          "stat": "mean",
          "value": 0.05
        }
      ]
    }
  ],
  "title": "DAQ1Mod3/ai0 tracks DAQ1Mod4/ao0 (tight 0.05% limit)",
  "created_at": "2026-09-01T08:01:03+00:00",
